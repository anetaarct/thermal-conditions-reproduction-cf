**/*.quarto_ipynb

# Local model objects and computational environment are not published.
*.rds
models/
.Rlib/

# Local backups, logs, and transient output.
.archive_*/
*.log
Rplots.pdf
index.tex

# Raw field data remain private; only explicitly derived public CSV files are published.
data_raw/

# Quarto must never copy private/local model objects into the public site.
docs/models/
docs/.archive_*/

# Render caches are local and can contain copied package files.
_freeze/

# Individual-level analytical datasets and audit exports remain private.
data_derived/breeding_reproduction_*.csv
data_derived/*model_data.csv
data_derived/reproductive_model_data.csv
data_derived/laying_date_model_data.csv
docs/data_derived/breeding_reproduction_*.csv
docs/data_derived/*model_data.csv
docs/data_derived/reproductive_model_data.csv
docs/data_derived/laying_date_model_data.csv

